STACY_TIMEZONE=America/Toronto
# Persistent paths, separate from the source checkout and disposable sandboxes.
# Defaults: ~/.local/share/stacy/state.sqlite3 and ~/.local/share/stacy/memory
# STACY_DATA_DIR=/absolute/path/to/stacy-data
# STACY_MEMORY_DIR=/absolute/path/to/stacy-memory
# Optional MCP directory: copy mcp.example.json to mcp.json, edit it, then restart Stacy.
# STACY_MCP_CONFIG=./mcp.json

# Direct OpenAI key for the Realtime voice connection.
OPENAI_API_KEY=
STACY_REALTIME_MODEL=gpt-realtime-2.1
STACY_VOICE=marin
# iMessage uses a separate text model; Realtime is voice only.
STACY_TEXT_MODEL=gpt-6-luna
# Pipecat background context summarization (same OpenAI key).
# STACY_SUMMARY_MODEL=gpt-4.1-mini
# Quiet typing during silent processing. Disable with off.
# STACY_WORK_SOUND=off
# far_field: laptop/room microphone; near_field: headset microphone.
# Noise reduction helps turn detection but does not provide acoustic echo cancellation.
STACY_NOISE_REDUCTION=far_field
# STACY_LOG_LEVEL=DEBUG
# Built-in Pipecat OpenTelemetry spans are saved locally alongside voice/tool traces.
# STACY_OTEL_ENABLED=false
EXA_API_KEY=
# Composio Connect consumer key (ck_) from For You > Sessions & API Key.
# Account sign-in happens through provider links returned in the iMessage conversation.
COMPOSIO_API_KEY=
E2B_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback
# auto selects Soloist when its key/URL is configured, otherwise Web API if configured.
# STACY_SPOTIFY_BACKEND=soloist
SOLOIST_API_KEY=
# Soloist runs separately on Linux (or in the development Docker container).
# SOLOIST_WS_URL=ws://127.0.0.1:9090
# On macOS, stacy start automatically bridges the Docker player's audio/discovery.
# Set false if running the bridge separately or forwarding to a different Linux host.
# SOLOIST_HOST_BRIDGE=false
